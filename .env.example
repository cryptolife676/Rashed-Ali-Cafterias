# Next.js public (browser-safe)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Server-only
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_PROJECT_ID=YOUR_PROJECT_ID

# Cron auth — Vercel sends this as: Authorization: Bearer ${CRON_SECRET}
CRON_SECRET=GENERATE_A_LONG_RANDOM_STRING

# Optional: email alerts via Resend
RESEND_API_KEY=
ALERT_EMAIL_TO=admin@example.com
ALERT_EMAIL_FROM=alerts@yourdomain.com

# Inactivity thresholds (days)
INACTIVITY_WARN_DAYS=5
INACTIVITY_ALERT_DAYS=6
